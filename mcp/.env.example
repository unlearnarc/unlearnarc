# ── UnlearnArc MCP server environment ──────────────────────────────────────────
# Copy to mcp/.env and fill in values.
# The MCP server itself reads these; the Java backend is the authority for auth.

# Base URL of the running Java application (no trailing slash)
UNLEARNARC_API_URL=http://localhost:8085

# Admin credentials — the server authenticates once and caches the JWT.
# These must match the ADMIN_EMAIL / ADMIN_PASSWORD in backend/.env
ADMIN_EMAIL=
ADMIN_PASSWORD=
