# ============================================================================
# backend/.env.example — template. Copy to backend/.env and fill in values.
#   cp backend/.env.example backend/.env
# .env is gitignored; this .example file is committed as documentation.
# Core variables below are required; AI authoring variables are optional.
# ============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8085

# ─── DataSource ───────────────────────────────────────────────────────────────
# Local MySQL:
#   jdbc:mysql://127.0.0.1:3306/unlearnarc?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Aiven (SSL required):
#   jdbc:mysql://<host>:<port>/defaultdb?sslMode=REQUIRE&serverTimezone=UTC
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DB_POOL_SIZE=10

# ─── JPA / Hibernate ──────────────────────────────────────────────────────────
# Adds missing entity tables/columns at startup (including profile sharing/rank).
# Use validate only when applying schema migrations separately before deployment.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
LOG_LEVEL_APP=DEBUG

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins. Cloud example:
#   https://unlearnarc-student.vercel.app,https://unlearnarc-admin.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── Google OAuth2 ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:  http://localhost:8085/oauth2/callback/google
# Render: https://<backend>.onrender.com/oauth2/callback/google
GOOGLE_REDIRECT_URI=http://localhost:8085/oauth2/callback/google

# ─── OAuth2 Redirect URIs (frontend) ──────────────────────────────────────────
OAUTH2_REDIRECT_URI=http://localhost:3002/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:3002/auth/error

# ─── AI Content Assistant (optional, backend only — never use VITE_ keys) ──────
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional background Web Push. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or HTTPS URL identifying your service
VAPID_SUBJECT=
