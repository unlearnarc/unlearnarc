.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# ─── Secrets / local env (NEVER commit) ─────────────────────────────────────────
.env
.env.*
!.env.example
**/application-local.properties
**/application-secret.properties

